              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listing is updated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.include(pm.collectionVariables.get('updatedTitle'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete listing",
          "request": {
            "method": "POST",

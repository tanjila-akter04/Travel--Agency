    {
      "name": "Listing CRUD workflow",
      "item": [
        {
          "name": "Create listing",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('listingTitle', 'Postman listing ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listing is created and appears in the index', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const title = pm.collectionVariables.get('listingTitle');",
                  "    const html = pm.response.text();",
                  "    const links = html.matchAll(/<a href=\"\\/listings\\/([a-f0-9]{24})\" class=\"listing-link\">([\\s\\S]*?)<\\/a>/gi);",
                  "    let listingId;",
                  "    for (const link of links) {",
                  "        if (link[2].includes(title)) {",
                  "            listingId = link[1];",
                  "            break;",
                  "        }",
                  "    }",
                  "    pm.expect(listingId, 'created listing link').to.be.ok;",
                  "    pm.collectionVariables.set('listingId', listingId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "listing[title]",
                  "value": "{{listingTitle}}",
                  "type": "text"
                },
                {
                  "key": "listing[description]",
                  "value": "Created by the Postman CRUD workflow",
                  "type": "text"
                },
                {
                  "key": "listing[image][url]",
                  "value": "https://example.com/postman-listing.jpg",
                  "type": "text"
                },
                {
                  "key": "listing[price]",
                  "value": "1500",
                  "type": "text"
                },
                {
                  "key": "listing[location]",
                  "value": "Cox's Bazar",
                  "type": "text"
                },
                {
                  "key": "listing[country]",
                  "value": "Bangladesh",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ]
            }
          }
        },
        {
          "name": "Show created listing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created listing details render', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.include(pm.collectionVariables.get('listingTitle'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit listing form",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}/edit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}",
                "edit"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Edit listing form renders', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.include('Edit your Listing');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "listing[title]",
                  "value": "{{updatedTitle}}",
                  "type": "text"
                },
                {
                  "key": "listing[description]",
                  "value": "Updated by the Postman CRUD workflow",
                  "type": "text"
                },
                {
                  "key": "listing[image][url]",
                  "value": "https://example.com/postman-listing-updated.jpg",
                  "type": "text"
                },
                {
                  "key": "listing[price]",
                  "value": "1800",
                  "type": "text"
                },
                {
                  "key": "listing[location]",
                  "value": "Saint Martin",
                  "type": "text"
                },
                {
                  "key": "listing[country]",
                  "value": "Bangladesh",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}?_method=PUT",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",

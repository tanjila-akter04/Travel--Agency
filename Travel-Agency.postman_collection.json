                  "pm.test('Listing is deleted from the index', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).not.to.include(pm.collectionVariables.get('updatedTitle'));",
                  "});"
                ]
              }
            }
          ]
        }
